    },
    {
      "id": "electron-app-lifecycle",
      "title": "应用生命周期与 BrowserWindow",
      "outcome": "能解释 ready/window-all-closed/before-quit/activate 等事件时序，独立实现单实例锁与 macOS 重新创建窗口的逻辑",
      "chapter_refs": [
        "docs/part1-background/05-lifecycle.md",
        "docs/part2-core/07-windows.md"
      ]
    },
    {
      "id": "electron-ipc",
      "title": "IPC 通信：invoke/handle/send/MessagePort",
      "outcome": "能为四种 IPC 模式选型，能写出 invoke/handle 与主进程主动推送的完整示例，并解释结构化克隆的限制",
      "chapter_refs": [
        "docs/part2-core/09-ipc.md"
      ]
    },
    {
      "id": "electron-security-baseline",
      "title": "安全模型：contextIsolation/sandbox/contextBridge 三开关",
      "outcome": "能解释三道防线的职责分工，能写出符合现代安全基线的 webPreferences，能用 preload + contextBridge 暴露最小化 API",
      "chapter_refs": [
        "docs/part2-core/10-security.md"
      ]
    },
    {
      "id": "electron-preload-contextbridge",
      "title": "preload 桥接与 contextBridge 白名单",
      "outcome": "能写出暴露语义化窄接口的 preload，能在桥一侧做参数校验，能让事件订阅返回取消函数",
      "chapter_refs": [
        "docs/part2-core/09-ipc.md",
        "docs/part2-core/10-security.md"
      ]
    },
    {
      "id": "electron-typed-ipc",
      "title": "IPC 类型契约（TypeScript）",
      "outcome": "能用 TypeScript 定义主/渲染两侧共享的 IPC 通道契约，使编译期能查出通道名拼错与参数类型不匹配",
      "chapter_refs": [
        "docs/part2-core/09-ipc.md",
        "docs/part3-engineering/15-scaffold.md"
      ]
    },
    {
      "id": "electron-window-lifecycle",
      "title": "BrowserWindow 生命周期与多窗口管理",
      "outcome": "能解释 BrowserWindow 创建/就绪/聚焦/关闭/销毁的完整事件链，能实现窗口状态持久化与多账号窗口隔离",
      "chapter_refs": [
        "docs/part2-core/07-windows.md",
        "docs/part1-background/05-lifecycle.md"
      ]
    },
    {
      "id": "electron-packaging-builder",
      "title": "electron-builder 完整打包配置",
      "outcome": "能写一份覆盖三平台的 electron-builder.yml，理解 asar / asarUnpack / extraResources / afterSign 钩子的边界",
      "chapter_refs": [
        "docs/part3-engineering/19-packaging.md"
      ]
    },
    {
      "id": "electron-packaging-forge",
      "title": "Electron Forge 打包与 makers 体系",
      "outcome": "能用 Forge 的 maker 体系产出多平台安装包，理解 Forge 与 electron-builder 在产物与自动更新集成上的差异",
      "chapter_refs": [
        "docs/part3-engineering/19-packaging.md"
      ]
    },
    {
      "id": "electron-signing",
      "title": "代码签名与公证",
