{
  "local_series": "learn-electron",
  "capabilities": [
    {
      "id": "electron-process-model",
      "title": "Electron 进程模型与进程边界",
      "outcome": "能独立画出一张进程全景图，准确说出主进程/渲染进程/GPU 进程/Utility Process 各自的能力面与崩溃域，并解释为什么渲染进程默认没有 Node",
      "chapter_refs": [
        "docs/part1-background/04-process-model.md",
        "docs/part1-background/03-architecture.md",
        "docs/part1-background/05-lifecycle.md"
