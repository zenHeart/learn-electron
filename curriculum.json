    {
      "id": "electron-observability",
      "title": "监控与可观测性：Crashpad + Sentry",
      "outcome": "能接入崩溃上报，能读取 minidump，能用 source map 与符号文件做堆栈符号化",
      "chapter_refs": [
        "docs/part3-engineering/23-observability.md"
      ]
    },
    {
      "id": "electron-debugging",
      "title": "调试体系：主进程/渲染进程/CDP",
      "outcome": "能用 --inspect 调试主进程，能用 Chrome DevTools 远程连接渲染进程，能用 chrome://gpu 与 chrome://tracing 诊断 GPU 与启动问题",
      "chapter_refs": [
